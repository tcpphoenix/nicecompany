---
// The signature element: the logo's fire / ice / water ring drawn as a pressure gauge.
// Each segment leads to its service; the needle swings to whatever you point at.
import Icon from './Icon.astro';
import { href } from '../lib/href';
import { services, type Accent } from '../data/site';

interface Props {
  /** Segment the needle rests on. Omit on the home page. */
  active?: Accent;
  /** Show the labelled links under the dial. */
  legend?: boolean;
}
const { active, legend = true } = Astro.props;

const cx = 200, cy = 212, R = 188, r = 124;
const rad = (deg: number) => (deg * Math.PI) / 180;
const pt = (radius: number, deg: number) =>
  `${(cx + radius * Math.cos(rad(deg))).toFixed(2)} ${(cy - radius * Math.sin(rad(deg))).toFixed(2)}`;

// Math angles: 180° is the left end of the dial, 0° the right end.
const spans: Record<Accent, [number, number]> = { fire: [180, 121.5], ice: [118.5, 61.5], water: [58.5, 0] };
const needleAngle: Record<Accent, number> = { fire: -60, ice: 0, water: 60 };

const segments = services.map((s) => {
  const [a1, a2] = spans[s.accent];
  const mid = (a1 + a2) / 2;
  const [ix, iy] = pt((R + r) / 2, mid).split(' ').map(Number);
  return {
    ...s,
    d: `M ${pt(R, a1)} A ${R} ${R} 0 0 1 ${pt(R, a2)} L ${pt(r, a2)} A ${r} ${r} 0 0 0 ${pt(r, a1)} Z`,
    icon: { x: ix - 22, y: iy - 22 },
  };
});

const ticks = Array.from({ length: 19 }, (_, i) => {
  const deg = 180 - i * 10;
  const major = i % 3 === 0;
  return { from: pt(R + 8, deg), to: pt(R + (major ? 20 : 14), deg), major };
});
---
<div class="gauge" data-active={active} style={`--rest: ${active ? needleAngle[active] : 0}deg`}>
  <svg class="dial" viewBox="0 0 400 236" aria-hidden="true" focusable="false">
    <g class="ticks">
      {ticks.map((t) => <path d={`M ${t.from} L ${t.to}`} class:list={{ major: t.major }} />)}
    </g>
    {segments.map((s) => (
      <a href={href(`/${s.slug}/`)} tabindex="-1" class="seg" data-seg={s.accent}>
        <path d={s.d} />
        <svg x={s.icon.x} y={s.icon.y} width="44" height="44" viewBox="0 0 24 24" class="seg-icon">
          <Icon name={s.accent} size={24} />
        </svg>
      </a>
    ))}
    <g class="needle">
      <path d={`M ${cx - 7} ${cy} L ${cx} ${cy - 112} L ${cx + 7} ${cy} Z`} />
      <circle cx={cx} cy={cy} r="17" />
      <circle cx={cx} cy={cy} r="5" class="hub-dot" />
    </g>
  </svg>

  {legend && (
    <ul class="legend">
      {segments.map((s) => (
        <li>
          <a href={href(`/${s.slug}/`)} data-seg={s.accent} aria-current={active === s.accent ? 'page' : undefined}>
            <span class="legend-name">
              <Icon name={s.accent} size={18} />
              {s.name}
            </span>
            <span class="legend-sum">{s.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .gauge { --needle: var(--rest); }

  /* Pointing at a segment or its label swings the needle there. */
  .gauge:has([data-seg='fire']:hover, [data-seg='fire']:focus-visible) { --needle: -60deg; }
  .gauge:has([data-seg='ice']:hover, [data-seg='ice']:focus-visible) { --needle: 0deg; }
  .gauge:has([data-seg='water']:hover, [data-seg='water']:focus-visible) { --needle: 60deg; }

  .dial { width: 100%; height: auto; overflow: visible; }

  .ticks path { stroke: var(--line); stroke-width: 2; stroke-linecap: round; }
  .ticks path.major { stroke: #9aa7b4; stroke-width: 2.5; }

  .seg path {
    stroke-width: 5;
    stroke-linejoin: round;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
  .seg[data-seg='fire'] path { fill: var(--fire); stroke: var(--fire); }
  .seg[data-seg='ice'] path { fill: var(--ice); stroke: var(--ice); }
  .seg[data-seg='water'] path { fill: var(--water); stroke: var(--water); }
  .seg-icon { color: var(--white); pointer-events: none; overflow: visible; }
  .seg:hover path { filter: brightness(1.08); }

  /* On a service page the other two segments step back. */
  .gauge[data-active] .seg path { opacity: 0.28; }
  .gauge[data-active='fire'] .seg[data-seg='fire'] path,
  .gauge[data-active='ice'] .seg[data-seg='ice'] path,
  .gauge[data-active='water'] .seg[data-seg='water'] path,
  .gauge[data-active] .seg:hover path { opacity: 1; }

  .needle {
    transform-box: view-box;
    transform-origin: 200px 212px;
    transform: rotate(var(--needle));
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: sweep 1.2s cubic-bezier(0.34, 1.4, 0.64, 1) 0.2s backwards;
    fill: var(--ink);
    pointer-events: none;
  }
  .hub-dot { fill: var(--white); }

  @keyframes sweep {
    from { transform: rotate(-90deg); }
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .legend a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 0.7rem 0.8rem;
    border-radius: 12px;
    text-decoration: none;
    border: 1.5px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .legend a:hover, .legend a[aria-current='page'] { background: var(--frost); border-color: var(--line); }
  .legend-name {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 800;
    font-stretch: 85%;
    font-size: 1rem;
    line-height: 1.3;
  }
  .legend-name :global(svg) { flex: none; }
  .legend [data-seg='fire'] :global(svg) { color: var(--fire); }
  .legend [data-seg='ice'] :global(svg) { color: var(--ice); }
  .legend [data-seg='water'] :global(svg) { color: var(--water); }
  .legend-sum { font-size: var(--step--1); color: var(--steel); line-height: 1.45; }

  @media (max-width: 559px) {
    .legend { grid-template-columns: 1fr; gap: 0.25rem; }
    .legend a { border-color: var(--line); }
  }
</style>
