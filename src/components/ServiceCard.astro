---
// Photo card for a service, as in the concept's "our services" row.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { href } from '../lib/href';
import { servicePhoto } from '../lib/photos';
import type { Service } from '../data/site';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---
<article class="card" data-accent={service.accent}>
  <div class="photo">
    <div class="media">
      <Image src={servicePhoto[service.slug]} alt="" widths={[400, 640, 900]} sizes="(max-width: 759px) 100vw, 33vw" quality={70} loading="lazy" />
    </div>
    <span class="badge"><Icon name={service.accent} size={24} /></span>
  </div>
  <div class="body">
    <h3><a href={href(`/${service.slug}/`)}>{service.name}</a></h3>
    <p class="sum">{service.summary}</p>
    <ul>
      {service.items.slice(0, 3).map((i) => (
        <li><Icon name="check" size={16} /> {i.title}</li>
      ))}
    </ul>
    <span class="more" aria-hidden="true">ვრცლად <Icon name="arrow" size={16} /></span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: clip;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 24px 48px -28px rgb(11 20 32 / 0.45); }
  /* The badge overlaps the photo's bottom edge, so it lives outside the clipped box. */
  .photo { position: relative; }
  .media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--navy-900); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .card:hover .media img { transform: scale(1.04); }
  .badge {
    position: absolute;
    left: 1.1rem;
    bottom: -1.4rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--white);
    border: 3px solid var(--white);
    z-index: 1;
  }
  .body { display: grid; gap: 0.5rem; align-content: start; padding: 2rem 1.3rem 1.3rem; }
  h3 { font-size: var(--step-2); font-stretch: 80%; font-weight: 800; }
  h3 a { text-decoration: none; }
  /* The whole card is clickable through the heading link. */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .sum { color: var(--steel); font-size: 0.95rem; }
  ul { display: grid; gap: 0.3rem; margin-top: 0.25rem; }
  li { display: flex; gap: 0.45rem; align-items: baseline; font-size: 0.95rem; line-height: 1.45; }
  li :global(svg) { flex: none; color: var(--blue-600); transform: translateY(2px); }
  .more { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.5rem; font-weight: 800; color: var(--blue-600); }
</style>
