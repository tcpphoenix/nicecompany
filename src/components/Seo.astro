---
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Page path relative to the site root, e.g. "/gatboba/". */
  path: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, description, path, schema = [], noindex = false } = Astro.props;
const root = new URL(import.meta.env.BASE_URL, Astro.site);
const canonical = new URL(path.replace(/^\//, ''), root).href;
const ogImage = new URL('og.png', root).href;
const graph = schema.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }) : '';
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="ka_GE" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" type="image/png" href={new URL('favicon.png', root).pathname} />
<link rel="apple-touch-icon" href={new URL('apple-touch-icon.png', root).pathname} />
<meta name="theme-color" content="#172231" />

{graph && <script type="application/ld+json" set:html={graph} />}
