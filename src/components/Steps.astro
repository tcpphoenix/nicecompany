---
// A real sequence, so it is numbered.
import { steps } from '../data/site';
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <span class="num" aria-hidden="true">{i + 1}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    counter-reset: step;
  }
  li { position: relative; display: grid; gap: 0.5rem; align-content: start; }
  /* Pipe connecting the steps */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: 3.75rem;
    right: -1.25rem;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--accent), var(--line));
  }
  .num {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 3px solid var(--accent);
    background: var(--white);
    font-weight: 800;
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.5rem;
  }
  p { color: var(--steel); }

  @media (max-width: 759px) {
    .steps { grid-template-columns: 1fr; gap: 1.5rem; }
    li { padding-left: 4.25rem; }
    .num { position: absolute; left: 0; top: 0; margin: 0; }
    li:not(:last-child)::after {
      top: 3.25rem;
      bottom: -1.25rem;
      left: 1.4rem;
      right: auto;
      width: 3px;
      height: auto;
      background: linear-gradient(180deg, var(--accent), var(--line));
    }
  }
</style>
