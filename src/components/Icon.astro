---
// Small inline icon set. Stroke icons inherit currentColor.
export type IconName = 'fire' | 'ice' | 'water' | 'phone' | 'whatsapp' | 'viber' | 'arrow' | 'check' | 'pin';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'fire' && (
    <path fill="currentColor" stroke="none" d="M12.3 2c.6 3.3 4.9 5.6 4.9 10.6a5.2 5.2 0 0 1-10.4 0c0-2.2 1-3.9 2.3-5 .1 2 .9 3.2 2 3.4-.4-3.3-.2-6.3 1.2-9Z" />
  )}
  {name === 'ice' && (
    <g>
      <path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7" />
      <path d="m9.5 3.5 2.5 2 2.5-2M9.5 20.5l2.5-2 2.5 2M3.9 10.1l3-.9-.6-3.1M20.1 13.9l-3 .9.6 3.1M6.3 17.9l.6-3.1-3-.9M17.7 6.1l-.6 3.1 3 .9" />
    </g>
  )}
  {name === 'water' && (
    <path fill="currentColor" stroke="none" d="M12 2.2c3.6 4.6 6.2 8 6.2 11.7a6.2 6.2 0 0 1-12.4 0C5.8 10.2 8.4 6.8 12 2.2Z" />
  )}
  {name === 'phone' && (
    <path d="M21.5 16.6v3a2 2 0 0 1-2.2 2 19.6 19.6 0 0 1-8.6-3 19.3 19.3 0 0 1-6-6 19.6 19.6 0 0 1-3-8.7A2 2 0 0 1 3.7 1.8h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L7.7 9.6a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.6 2Z" />
  )}
  {name === 'whatsapp' && (
    <g>
      <path d="m3.2 20.8 1.4-4.3a8.6 8.6 0 1 1 3.2 3Z" />
      <path stroke-width="1.6" d="M9 8.6c.2 2.9 3.3 6 6.3 6.3l.9-1.5-1.8-.9-.8.8c-1.2-.5-2.3-1.6-2.8-2.8l.8-.8-.9-1.8Z" />
    </g>
  )}
  {name === 'viber' && (
    <g>
      <path d="M12 2.8c5.4 0 8.6 2 8.6 7.9s-3.2 7.8-8.6 7.8c-.8 0-1.6 0-2.3-.1L6.5 21v-3.5c-2.1-1.1-3.1-3.2-3.1-6.8 0-5.9 3.2-7.9 8.6-7.9Z" />
      <path stroke-width="1.6" d="M12.5 6.6a3.8 3.8 0 0 1 3.4 3.4M12.4 8.6c.8.1 1.3.7 1.4 1.4" />
    </g>
  )}
  {name === 'arrow' && <path d="M4.5 12h15M13.5 6l6 6-6 6" />}
  {name === 'check' && <path d="m4.5 12.5 4.5 4.5 10.5-10.5" />}
  {name === 'pin' && (
    <g>
      <path d="M12 21.5s7-6.2 7-11.8a7 7 0 0 0-14 0c0 5.6 7 11.8 7 11.8Z" />
      <circle cx="12" cy="9.7" r="2.4" />
    </g>
  )}
</svg>
