---
// Full-bleed photo header with a navy shade, as in the ChatGPT concept.
// The default slot holds the H1, copy and buttons; the "below" slot sits at the bottom edge.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { mtavruli } from '../lib/mtavruli';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  /** "tall" for the home page, "page" for inner pages. */
  size?: 'tall' | 'page';
  /** CSS object-position for the photo. */
  focus?: string;
}
const { image, alt, eyebrow, size = 'page', focus = '70% 50%' } = Astro.props;
---
<section class:list={['photo-hero', `photo-hero--${size}`]}>
  <Image
    class="bg"
    src={image}
    alt={alt}
    widths={[640, 960, 1280, 1920]}
    quality={60}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    style={`object-position: ${focus}`}
  />
  <div class="shade" aria-hidden="true"></div>
  <div class="wrap content">
    <div class="copy">
      <p class="eyebrow">{mtavruli(eyebrow)}</p>
      <slot />
    </div>
  </div>
  {Astro.slots.has('below') && (
    <div class="below">
      <div class="wrap"><slot name="below" /></div>
    </div>
  )}
</section>

<style>
  .photo-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--navy-950);
    color: var(--white);
    overflow: hidden;
  }
  .photo-hero--tall { min-height: clamp(30rem, 66vh, 38rem); }
  .photo-hero--page { min-height: clamp(26rem, 60vh, 34rem); }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Navy on the text side, fading toward the photo; keeps white text readable. */
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(11 20 32 / 0.95) 0%, rgb(11 20 32 / 0.88) 38%, rgb(11 20 32 / 0.5) 68%, rgb(11 20 32 / 0.25) 100%),
      linear-gradient(0deg, rgb(11 20 32 / 0.85) 0%, rgb(11 20 32 / 0) 35%);
  }

  .content { display: flex; align-items: center; padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
  .copy { display: grid; gap: 1.1rem; justify-items: start; max-width: 48rem; }
  .eyebrow {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--blue-300);
  }
  .copy :global(h1) { color: var(--white); font-size: clamp(1.8rem, 1.2rem + 2.2vw, 3rem); max-width: 20em; }
  .copy :global(.lead) { color: rgb(255 255 255 / 0.82); }
  .copy :global(a:not([class])) { color: var(--white); }

  .below { position: relative; padding-bottom: 1.5rem; }

  /* Phones: the text covers the photo's full width, so shade it evenly. */
  @media (max-width: 759px) {
    .shade { background: linear-gradient(180deg, rgb(11 20 32 / 0.78), rgb(11 20 32 / 0.92)); }
    .photo-hero--tall, .photo-hero--page { min-height: 0; }
  }
</style>
