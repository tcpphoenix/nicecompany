---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { href } from '../lib/href';
import { services, site, telLink, whatsappLink, phoneLocal } from '../data/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const isService = services.some((s) => s.slug === current);

const main = [
  { label: 'მთავარი', path: '/', key: 'home' },
  { label: 'ჩვენ შესახებ', path: '/chven-shesakheb/', key: 'about' },
  { label: 'სერვისები', path: '/#services', key: 'services' },
  { label: 'ბიზნესისთვის', path: '/biznesi/', key: 'biznesi' },
  { label: 'კონტაქტი', path: '/kontaqti/', key: 'kontaqti' },
];
const isCurrent = (key: string) => key === current || (key === 'services' && isService);
---
<header class="header">
  <div class="wrap bar">
    <a class="brand" href={href('/')} aria-label={`${site.name} — მთავარი გვერდი`}>
      <Logo tagline />
    </a>

    <nav class="nav" aria-label="მთავარი მენიუ">
      <ul>
        {main.map((it) => (
          <li>
            <a href={href(it.path)} aria-current={isCurrent(it.key) ? 'page' : undefined}>{it.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="reach">
      <a class="phone" href={telLink()}>
        <Icon name="phone" size={20} />
        <span>{phoneLocal()}</span>
      </a>
      <a class="wa" href={whatsappLink()} target="_blank" rel="noopener">
        მოგვწერეთ WhatsApp-ით <Icon name="whatsapp" size={15} />
      </a>
    </div>

    <div class="compact">
      <a class="round-call" href={telLink()} aria-label={`დარეკვა: ${phoneLocal()}`}>
        <Icon name="phone" size={20} />
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="მენიუ">
        <Icon name="menu" size={22} class="i-open" />
        <Icon name="close" size={22} class="i-close" />
      </button>
    </div>
  </div>

  <div class="panel" id="site-menu" hidden>
    <nav class="wrap" aria-label="მენიუ">
      <ul class="panel-main">
        {main.map((it) => (
          <li><a href={href(it.path)} aria-current={isCurrent(it.key) ? 'page' : undefined}>{it.label}</a></li>
        ))}
      </ul>
      <p class="panel-label">სერვისები</p>
      <ul class="panel-services">
        {services.map((s) => (
          <li><a href={href(`/${s.slug}/`)} aria-current={current === s.slug ? 'page' : undefined}>{s.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Compact-header menu toggle; without JS the menu stays hidden and the bottom bar still offers calling.
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.getElementById('site-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      btn?.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 6px 24px -18px rgb(11 20 32 / 0.5);
  }
  /* The header runs a little wider than the content so the full menu fits in one row. */
  .bar {
    max-width: 82rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 5rem;
  }
  .brand { display: flex; text-decoration: none; margin-right: auto; flex: none; }

  .nav ul { display: flex; gap: 0.25rem; }
  .nav a {
    position: relative;
    display: inline-flex;
    padding: 0.5rem 0.7rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover { color: var(--blue-600); }
  .nav a[aria-current='page'] { color: var(--blue-600); }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.05rem;
    height: 2px;
    border-radius: 2px;
    background: var(--blue);
  }

  .reach { display: grid; justify-items: start; gap: 0.1rem; flex: none; }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--navy-900);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .phone :global(svg) { flex: none; color: var(--navy-900); }
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 1.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--steel);
    text-decoration: none;
  }
  .wa :global(svg) { flex: none; color: #1a9e4b; }
  .wa:hover { color: var(--ink); }

  .compact { display: none; align-items: center; gap: 0.6rem; }
  .round-call {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--blue);
    color: var(--white);
  }
  .menu-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-close) { display: block; }

  .panel { border-top: 1px solid var(--line); background: var(--white); }
  .panel nav { padding-block: 0.75rem 1.25rem; }
  .panel a {
    display: block;
    padding: 0.7rem 0;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .panel a[aria-current='page'] { color: var(--blue-600); }
  .panel-label { margin-top: 1rem; font-size: 0.85rem; font-weight: 700; color: var(--steel); }
  .panel-services a { font-weight: 600; padding-left: 0.75rem; }

  /* Below 1280px the full menu folds into the menu button. */
  @media (max-width: 1279px) {
    .nav { display: none; }
    .compact { display: flex; }
    .bar { min-height: 4.25rem; }
  }
  @media (min-width: 1280px) {
    .panel { display: none; }
  }
  /* Tablets show the number itself, so the round call button is only for phones. */
  @media (min-width: 900px) {
    .round-call { display: none; }
  }
  @media (max-width: 899px) {
    .reach { display: none; }
    .brand :global(.tag) { display: none; }
  }
  @media (max-width: 380px) {
    .brand :global(.mark) { width: 2.4rem; }
  }
</style>
