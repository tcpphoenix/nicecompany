---
import { Image } from 'astro:assets';
import emblem from '../assets/emblem.png';
import Icon from './Icon.astro';
import { href } from '../lib/href';
import { services, site, telLink } from '../data/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;
---
<header class="header">
  <div class="wrap bar">
    <a class="brand" href={href('/')} aria-label={`${site.name} — მთავარი გვერდი`}>
      <Image src={emblem} alt="" width={52} height={38} loading="eager" />
      <span class="wordmark"><span>ნისე</span><span class="wordmark-b">კომპანი</span></span>
    </a>

    <nav class="nav" aria-label="სერვისები">
      <ul>
        {services.map((s) => (
          <li>
            <a
              href={href(`/${s.slug}/`)}
              data-accent={s.accent}
              aria-current={current === s.slug ? 'page' : undefined}
            >
              <Icon name={s.accent} size={16} />
              {s.name}
            </a>
          </li>
        ))}
        <li>
          <a href={href('/kontaqti/')} aria-current={current === 'kontaqti' ? 'page' : undefined}>კონტაქტი</a>
        </li>
      </ul>
    </nav>

    <a class="phone" href={telLink()}>
      <Icon name="phone" size={18} />
      <span>{site.phone}</span>
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(244 247 249 / 0.88);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.25rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand img { width: 52px; height: auto; }
  .wordmark {
    font-weight: 800;
    font-stretch: 80%;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .wordmark-b { color: var(--water-ink); }

  .nav ul { display: flex; gap: 0.25rem; }
  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .nav a :global(svg) { color: var(--accent); }
  .nav a:hover { background: var(--white); }
  .nav a[aria-current='page'] { background: var(--white); box-shadow: inset 0 0 0 1.5px var(--accent); }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* On phones the bottom bar handles calling; services become a scrollable second row. */
  @media (max-width: 899px) {
    .phone { display: none; }
    .bar { flex-wrap: wrap; gap: 0; min-height: 3.5rem; }
    .brand { padding-block: 0.55rem; }
    .brand img { width: 44px; }
    .wordmark { font-size: 1.15rem; }
    .nav {
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 0.55rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav ul { width: max-content; }
    .nav a { font-size: 0.9rem; padding: 0.35rem 0.7rem; background: var(--white); border: 1px solid var(--line); }
  }
</style>
