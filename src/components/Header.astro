---
import { Image } from 'astro:assets';
import emblem from '../assets/emblem.png';
import Icon from './Icon.astro';
import { href } from '../lib/href';
import { services, site, telLink, whatsappLink, phoneLocal } from '../data/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const isService = services.some((s) => s.slug === current);

// Desktop shows a short menu; phones get a chip row that also lists each service.
const items = [
  { label: 'მთავარი', path: '/', key: 'home', where: 'desktop' },
  { label: 'ჩვენ შესახებ', path: '/chven-shesakheb/', key: 'about', where: 'both' },
  { label: 'სერვისები', path: '/#services', key: 'services', where: 'desktop' },
  ...services.map((s) => ({ label: s.name, path: `/${s.slug}/`, key: s.slug, accent: s.accent, where: 'mobile' })),
  { label: 'ბიზნესისთვის', path: '/biznesi/', key: 'biznesi', where: 'both' },
  { label: 'კონტაქტი', path: '/kontaqti/', key: 'kontaqti', where: 'both' },
] as { label: string; path: string; key: string; accent?: 'fire' | 'ice' | 'water'; where: string }[];

const isCurrent = (key: string) => key === current || (key === 'services' && isService);
---
<header class="header">
  <div class="wrap bar">
    <a class="brand" href={href('/')} aria-label={`${site.name} — მთავარი გვერდი`}>
      <Image src={emblem} alt="" width={52} height={38} densities={[1, 2, 3]} loading="eager" />
      <span class="wordmark"><span>ნისე</span><span class="wordmark-b">კომპანი</span></span>
    </a>

    <nav class="nav" aria-label="მთავარი მენიუ">
      <ul>
        {items.map((it) => (
          <li class={`only-${it.where}`}>
            <a href={href(it.path)} aria-current={isCurrent(it.key) ? 'page' : undefined}>
              {it.accent && <Icon name={it.accent} size={15} class={`ic ic--${it.accent}`} />}
              {it.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="reach">
      <a class="phone" href={telLink()}>
        <Icon name="phone" size={20} />
        <span>{phoneLocal()}</span>
      </a>
      <a class="wa" href={whatsappLink()} target="_blank" rel="noopener">
        მოგვწერეთ WhatsApp-ით <Icon name="whatsapp" size={15} />
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 6px 24px -18px rgb(11 20 32 / 0.5);
  }
  /* The header runs a little wider than the content so the full menu fits in one row. */
  .bar {
    max-width: 80rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-right: auto;
    flex: none;
  }
  .brand img { width: 52px; height: auto; }
  .wordmark {
    font-weight: 800;
    font-stretch: 80%;
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--navy-900);
  }
  .wordmark-b { color: var(--blue-600); }

  .nav ul { display: flex; gap: 0.25rem; }
  .only-mobile { display: none; }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover { color: var(--blue-600); }
  /* Blue underline under the current page, as in the concept. */
  .nav a[aria-current='page'] { color: var(--blue-600); }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--blue);
  }
  .nav :global(.ic) { flex: none; }
  .nav :global(.ic--fire) { color: var(--fire); }
  .nav :global(.ic--ice) { color: var(--ice); }
  .nav :global(.ic--water) { color: var(--water); }

  .reach { display: grid; justify-items: end; gap: 0.1rem; flex: none; }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--navy-900);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .phone :global(svg) { flex: none; color: var(--blue-600); }
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--steel);
    text-decoration: none;
  }
  .wa :global(svg) { flex: none; color: #1a9e4b; }
  .wa:hover { color: var(--ink); }

  /* Below 1280px the menu moves to its own scrollable row under the logo. */
  @media (max-width: 1279px) {
    .bar { flex-wrap: wrap; gap: 0; min-height: 3.5rem; }
    .brand { padding-block: 0.55rem; }
    .only-desktop { display: none; }
    .only-mobile { display: list-item; }
    .nav {
      order: 3;
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 0.6rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav ul { width: max-content; gap: 0.35rem; }
    .nav a {
      font-size: 0.9rem;
      padding: 0.35rem 0.75rem;
      background: var(--mist);
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    .nav a[aria-current='page'] { background: var(--navy-900); border-color: var(--navy-900); color: var(--white); }
    .nav a[aria-current='page']::after { display: none; }
  }
  /* On phones the bottom bar handles calling. */
  @media (max-width: 899px) {
    .reach { display: none; }
    .brand img { width: 44px; }
    .wordmark { font-size: 1.15rem; }
  }
</style>
