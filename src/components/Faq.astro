---
import type { Faq } from '../data/site';

interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 0.75rem; max-width: 50rem; }
  details {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0 1.4rem;
  }
  summary {
    position: relative;
    padding: 1.15rem 2.5rem 1.15rem 0;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 2.5px solid var(--accent-ink);
    border-bottom: 2.5px solid var(--accent-ink);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.2s ease;
  }
  details[open] summary::after { transform: translateY(-30%) rotate(-135deg); }
  p { padding-bottom: 1.25rem; color: var(--steel); }
</style>
