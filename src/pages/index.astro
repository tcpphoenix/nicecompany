---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Gauge from '../components/Gauge.astro';
import Icon from '../components/Icon.astro';
import ContactButtons from '../components/ContactButtons.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import Districts from '../components/Districts.astro';
import CallBand from '../components/CallBand.astro';
import AudienceChoice from '../components/AudienceChoice.astro';
import { services, whyUs } from '../data/site';
import { href } from '../lib/href';
import { mtavruli } from '../lib/mtavruli';
import { photos } from '../lib/photos';
import { businessSchema } from '../lib/schema';

const root = new URL(import.meta.env.BASE_URL, Astro.site);
---
<Base
  title="ნისეკომპანი — გათბობა, გაგრილება, წყალმომარაგება თბილისში"
  description="ქვაბების, კონდიციონერების, ბოილერების და ტუმბოების შეკეთება და მონტაჟი თბილისის ყველა რაიონში. დაგვირეკეთ ან მოგვწერეთ WhatsApp-ზე და Viber-ზე."
  path="/"
  schema={[businessSchema(root)]}
>
  <PhotoHero image={photos.hero} alt="გათბობის სისტემის მილები და მანომეტრები" eyebrow="სრული სერვისი" size="tall" focus="75% 50%">
    <h1>გათბობის, გაგრილების და წყლის ხელოსანი თბილისში</h1>
    <p class="hero-line">გათბობა • გაგრილება • წყალმომარაგება</p>
    <p class="lead">ქვაბი, კონდიციონერი, ბოილერი, ტუმბო თუ მილები — მოვალთ, დავადგენთ მიზეზს და შევაკეთებთ. სახლებსა და ბიზნესს თბილისის ყველა რაიონში.</p>
    <ContactButtons tone="light" />
    <ul class="hero-icons" slot="below">
      {services.map((s) => (
        <li>
          <a href={href(`/${s.slug}/`)} data-accent={s.accent}>
            <span class="ring"><Icon name={s.accent} size={24} /></span>
            <span class="txt">
              <span class="nm">{s.name}</span>
              <span class="sm">{s.summary}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </PhotoHero>

  <section class="audience" aria-label="ვისთვის">
    <div class="wrap">
      <AudienceChoice />
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="services-head">
        <div class="section-head">
          <p class="label">{mtavruli('ჩვენი სერვისები')}</p>
          <h2 id="services-title">პროფესიონალური მომსახურება ყველა მიმართულებით</h2>
        </div>
        <p class="services-intro">
          ვაკეთებთ გათბობის, გაგრილების და წყალმომარაგების სისტემების მონტაჟს, შეკეთებას და მომსახურებას —
          ქვაბებიდან და კონდიციონერებიდან ჩილერებამდე, ტუმბოებამდე და საქვაბეებამდე.
        </p>
      </div>
      <div class="cards">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="dial-section" aria-labelledby="dial-title">
    <div class="wrap dial-grid">
      <div class="dial-copy">
        <p class="label">{mtavruli('სწრაფი არჩევანი')}</p>
        <h2 id="dial-title">რა გაფუჭდა? აირჩიეთ სისტემა</h2>
        <p>მიუთითეთ ისარი გათბობაზე, გაგრილებაზე ან წყალზე და გადადით შესაბამის გვერდზე — იქ ნახავთ ხშირ პრობლემებს და იმას, თუ როგორ ვაგვარებთ მათ.</p>
      </div>
      <div class="dial-panel">
        <Gauge tone="dark" />
      </div>
    </div>
  </section>

  <section class="section why" aria-labelledby="why-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{mtavruli('რატომ ჩვენ')}</p>
        <h2 id="why-title">მარტივად და გასაგებად</h2>
      </div>
      <ul class="why-list">
        {whyUs.map((w) => (
          <li>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section steps-section" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{mtavruli('როგორ ვმუშაობთ')}</p>
        <h2 id="steps-title">ზარიდან შეკეთებამდე</h2>
      </div>
      <Steps />
    </div>
  </section>

  <section class="section districts-section">
    <div class="wrap">
      <Districts />
    </div>
  </section>

  <CallBand
    title="რამე გაფუჭდა?"
    text="დაგვირეკეთ ან მოგვწერეთ — გვითხარით, რა პრობლემაა და რომელ რაიონში ხართ."
  />
</Base>

<style>
  .hero-line {
    font-weight: 800;
    font-size: var(--step-1);
    color: var(--blue-300);
    letter-spacing: 0.01em;
  }

  .hero-icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-block: 1.1rem;
  }
  .hero-icons a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--white);
  }
  .ring {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: rgb(255 255 255 / 0.06);
    color: var(--accent);
    transition: background 0.2s ease;
  }
  [data-accent='fire'] .ring { color: #ff8a5c; }
  [data-accent='ice'] .ring { color: var(--blue-300); }
  [data-accent='water'] .ring { color: #4fd1d1; }
  .hero-icons a:hover .ring { background: rgb(255 255 255 / 0.14); }
  .txt { display: grid; line-height: 1.35; }
  .nm { font-weight: 800; }
  .sm { font-size: 0.85rem; color: rgb(255 255 255 / 0.72); }

  .audience { padding-top: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  #services { scroll-margin-top: 6.5rem; }

  .services-head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1rem 4rem;
    align-items: end;
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  .services-head .section-head { margin-bottom: 0; }
  .services-intro { color: var(--steel); }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }

  .dial-section {
    background: var(--navy-900);
    color: var(--white);
    padding-block: clamp(3.5rem, 2rem + 5vw, 6rem);
  }
  .dial-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .dial-grid > * { min-width: 0; }
  .dial-copy { display: grid; gap: 1rem; }
  .dial-copy .label { color: var(--blue-300); }
  .dial-copy h2 { color: var(--white); }
  .dial-copy p:last-child { color: rgb(255 255 255 / 0.75); max-width: 30rem; }
  .dial-panel {
    background: var(--navy-800);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 24px;
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
  }

  .why { background: var(--white); border-bottom: 1px solid var(--line); }
  .why-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .why-list li { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.25rem; border-top: 3px solid var(--blue); }
  .why-list p { color: var(--steel); }

  .districts-section { padding-top: 0; }

  @media (max-width: 1099px) {
    .why-list { grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 899px) {
    .services-head, .dial-grid { grid-template-columns: 1fr; }
    .hero-icons { grid-template-columns: 1fr; gap: 0.75rem; }
  }
  @media (max-width: 599px) {
    .why-list, .cards { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
