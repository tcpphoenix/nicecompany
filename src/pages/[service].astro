---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Icon from '../components/Icon.astro';
import ContactButtons from '../components/ContactButtons.astro';
import Steps from '../components/Steps.astro';
import Districts from '../components/Districts.astro';
import Faq from '../components/Faq.astro';
import CallBand from '../components/CallBand.astro';
import BusinessNote from '../components/BusinessNote.astro';
import { services, type Service } from '../data/site';
import { href } from '../lib/href';
import { mtavruli } from '../lib/mtavruli';
import { servicePhoto } from '../lib/photos';
import { businessSchema, serviceSchema, faqSchema, breadcrumbSchema } from '../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const root = new URL(import.meta.env.BASE_URL, Astro.site);
const path = `/${service.slug}/`;
const others = services.filter((s) => s.slug !== service.slug);
---
<Base
  title={service.title}
  description={service.description}
  path={path}
  accent={service.accent}
  current={service.slug}
  schema={[
    businessSchema(root),
    serviceSchema(root, service),
    faqSchema(service.faq),
    breadcrumbSchema(root, [
      { name: 'მთავარი', path: '/' },
      { name: service.name, path },
    ]),
  ]}
>
  <PhotoHero image={servicePhoto[service.slug]} alt={service.name} eyebrow={service.name}>
    <nav aria-label="ნავიგაციის ბილიკი" class="crumbs">
      <a href={href('/')}>მთავარი</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{service.name}</span>
    </nav>
    <h1>{service.h1}</h1>
    <p class="lead">{service.intro}</p>
    <ContactButtons tone="light" />
  </PhotoHero>

  <section class="section items-section" aria-labelledby="items-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{mtavruli('რას ვაკეთებთ')}</p>
        <h2 id="items-title">{service.name}: სერვისები</h2>
      </div>
      <ul class="items">
        {service.items.map((i) => (
          <li>
            <h3>{i.title}</h3>
            <p>{i.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="problems-title">
    <div class="wrap problems-grid">
      <div class="section-head">
        <p class="label">{mtavruli('ხშირი პრობლემები')}</p>
        <h2 id="problems-title">ეს გჭირთ?</h2>
        <p>თუ რომელიმე ნაცნობია, დაგვირეკეთ. ადგილზე დავადგენთ მიზეზს და გეტყვით, რა უნდა გაკეთდეს.</p>
      </div>
      <ul class="problems">
        {service.problems.map((p) => (
          <li><Icon name="check" size={20} /> {p}</li>
        ))}
      </ul>
    </div>
    <div class="wrap"><BusinessNote text={service.business} /></div>
  </section>

  <section class="section tinted" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{mtavruli('როგორ ვმუშაობთ')}</p>
        <h2 id="steps-title">ზარიდან შეკეთებამდე</h2>
      </div>
      <Steps />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{mtavruli('კითხვები')}</p>
        <h2 id="faq-title">ხშირად დასმული კითხვები</h2>
      </div>
      <Faq items={service.faq} />
    </div>
  </section>

  <section class="section districts-section">
    <div class="wrap">
      <Districts />
    </div>
  </section>

  <section class="section others" aria-labelledby="others-title">
    <div class="wrap">
      <h2 id="others-title" class="others-title">სხვა სერვისები</h2>
      <ul class="others-list">
        {others.map((o) => (
          <li data-accent={o.accent}>
            <a href={href(`/${o.slug}/`)}>
              <span class="o-icon"><Icon name={o.accent} size={22} /></span>
              <span class="o-text">
                <span class="o-name">{o.name}</span>
                <span class="o-sum">{o.summary}</span>
              </span>
              <Icon name="arrow" size={20} class="o-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CallBand
    title={`${service.name}: დაგვირეკეთ`}
    text="გვითხარით, რა პრობლემაა და რომელ რაიონში ხართ — შევთანხმდებით ვიზიტის დროზე."
  />
</Base>

<style>
  .crumbs { display: flex; gap: 0.5rem; font-size: var(--step--1); color: rgb(255 255 255 / 0.7); }
  .crumbs a { color: rgb(255 255 255 / 0.85); }
  .lead { font-size: var(--step-1); max-width: 36rem; line-height: 1.6; margin-bottom: 0.5rem; }

  /* Three per row; a short last row stretches to fill the width. */
  .items {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }
  .items li { grid-column: span 2; }
  .items li:nth-child(3n + 1):nth-last-child(2),
  .items li:nth-child(3n + 2):last-child { grid-column: span 3; }
  .items li:nth-child(3n + 1):last-child { grid-column: span 6; }
  .items li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 4px solid var(--accent);
    border-radius: var(--radius);
  }
  .items p { color: var(--steel); }

  .problems-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem 4rem;
    align-items: start;
  }
  .problems { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .problems li {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-size: 1.08rem;
  }
  .problems :global(svg) { flex: none; color: var(--accent-ink); transform: translateY(4px); }

  .tinted { background: var(--white); border-block: 1px solid var(--line); }
  .districts-section { padding-bottom: 0; }

  .others-title { font-size: var(--step-2); margin-bottom: 1.25rem; }
  .others-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .others-list a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .others-list a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .o-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    color: var(--white);
  }
  .o-text { display: grid; flex: 1; }
  .o-name { font-weight: 800; font-stretch: 85%; font-size: 1.2rem; }
  .o-sum { color: var(--steel); font-size: 0.95rem; }
  .others-list :global(.o-arrow) { color: var(--accent-ink); flex: none; }

  @media (max-width: 899px) {
    .problems-grid { grid-template-columns: 1fr; }
    .others-list { grid-template-columns: 1fr; }
    .items { grid-template-columns: 1fr; }
    .items li { grid-column: auto !important; }
  }
</style>
