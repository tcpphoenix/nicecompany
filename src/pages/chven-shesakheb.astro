---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Icon from '../components/Icon.astro';
import ContactButtons from '../components/ContactButtons.astro';
import Districts from '../components/Districts.astro';
import CallBand from '../components/CallBand.astro';
import { about, services } from '../data/site';
import { href } from '../lib/href';
import { mtavruli } from '../lib/mtavruli';
import { photos } from '../lib/photos';
import { businessSchema, aboutPageSchema, breadcrumbSchema } from '../lib/schema';

const root = new URL(import.meta.env.BASE_URL, Astro.site);
---
<Base
  title={about.title}
  description={about.description}
  path="/chven-shesakheb/"
  current="about"
  schema={[
    businessSchema(root),
    aboutPageSchema(root),
    breadcrumbSchema(root, [
      { name: 'მთავარი', path: '/' },
      { name: 'ჩვენ შესახებ', path: '/chven-shesakheb/' },
    ]),
  ]}
>
  <PhotoHero image={photos.band} alt="მილები და ონკანები ტექნიკურ ოთახში" eyebrow="ჩვენ შესახებ" focus="60% 50%">
    <nav aria-label="ნავიგაციის ბილიკი" class="crumbs">
      <a href={href('/')}>მთავარი</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">ჩვენ შესახებ</span>
    </nav>
    <h1>{about.h1}</h1>
    <p class="lead">{about.intro}</p>
    <ContactButtons tone="light" />
  </PhotoHero>

  <section class="section" aria-labelledby="what-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{mtavruli('რას ვაკეთებთ')}</p>
        <h2 id="what-title">სამი სისტემა — სახლისთვის და ბიზნესისთვის</h2>
      </div>
      <ul class="systems">
        {services.map((s) => (
          <li data-accent={s.accent}>
            <span class="ring"><Icon name={s.accent} size={22} /></span>
            <div>
              <h3><a href={href(`/${s.slug}/`)}>{s.name}</a></h3>
              <p>{s.summary}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="audiences">
        {about.audiences.map((a, i) => (
          <a class:list={['aud', { 'aud--dark': i === 1 }]} href={href(a.path)}>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <span class="go">{a.link} <Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tinted" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{mtavruli('როგორ ვმუშაობთ')}</p>
        <h2 id="how-title">ჩვენი პრინციპები</h2>
      </div>
      <ul class="principles">
        {about.principles.map((pr) => (
          <li>
            <Icon name="check" size={22} />
            <div>
              <h3>{pr.title}</h3>
              <p>{pr.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Districts />
    </div>
  </section>

  <CallBand
    title="გაქვთ კითხვა?"
    text="დაგვირეკეთ ან მოგვწერეთ WhatsApp-ზე და Viber-ზე — სიამოვნებით გიპასუხებთ."
    image={photos.heating}
  />
</Base>

<style>
  .crumbs { display: flex; gap: 0.5rem; font-size: var(--step--1); color: rgb(255 255 255 / 0.7); }
  .crumbs a { color: rgb(255 255 255 / 0.85); }
  .lead { font-size: var(--step-1); max-width: 36rem; line-height: 1.6; margin-bottom: 0.5rem; }

  .systems { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
  .systems li {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .ring {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    flex: none;
    border-radius: 50%;
    border: 2px solid currentColor;
  }
  [data-accent='fire'] .ring { color: var(--fire); }
  [data-accent='ice'] .ring { color: var(--ice); }
  [data-accent='water'] .ring { color: var(--water); }
  .systems h3 a { text-decoration: none; }
  .systems h3 a::after { content: ''; position: absolute; inset: 0; }
  .systems p { color: var(--steel); font-size: 0.95rem; }

  .audiences { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .aud {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .aud:hover { transform: translateY(-2px); }
  .aud h3 { font-size: var(--step-2); font-stretch: 82%; font-weight: 800; }
  .aud p { color: var(--steel); }
  .aud--dark { background: var(--navy-900); border-color: var(--navy-900); color: var(--white); }
  .aud--dark p { color: rgb(255 255 255 / 0.75); }
  .go { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.4rem; font-weight: 800; color: var(--blue-600); }
  .aud--dark .go { color: var(--blue-300); }

  .tinted { background: var(--white); border-block: 1px solid var(--line); }
  .principles { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.5rem 2rem; }
  .principles li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .principles li > :global(svg) { flex: none; color: var(--blue-600); margin-top: 0.2rem; }
  .principles h3 { margin-bottom: 0.25rem; }
  .principles p { color: var(--steel); }

  @media (max-width: 899px) {
    .systems, .audiences { grid-template-columns: 1fr; }
  }
</style>
