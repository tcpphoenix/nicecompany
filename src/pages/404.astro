---
import Base from '../layouts/Base.astro';
import Gauge from '../components/Gauge.astro';
import { href } from '../lib/href';
---
<Base
  title="გვერდი ვერ მოიძებნა | ნისეკომპანი"
  description="ეს გვერდი არ არსებობს ან გადატანილია. აირჩიეთ სერვისი ქვემოთ ან დაბრუნდით მთავარ გვერდზე და დაგვიკავშირდით."
  path="/404/"
  noindex
>
  <section class="section">
    <div class="wrap nf">
      <p class="label">შეცდომა 404</p>
      <h1>ეს გვერდი ვერ მოიძებნა</h1>
      <p>ბმული შეიძლება მოძველებულია. აირჩიეთ სერვისი ან <a href={href('/')}>დაბრუნდით მთავარ გვერდზე</a>.</p>
      <div class="dial"><Gauge /></div>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 1rem; justify-items: center; text-align: center; }
  .nf > p:not(.label) { color: var(--steel); max-width: 32rem; }
  .dial { width: 100%; max-width: 30rem; margin-top: 1.5rem; }
</style>
